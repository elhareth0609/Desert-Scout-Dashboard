/**
 * Firestore Security Rules
 *
 * CORE PHILOSOPHY:
 * This ruleset implements a strict hierarchical ownership model. Access control is primarily
 * driven by the document path, specifically the {userId} wildcard. This ensures that every 
 * piece of data—from high-level flight logs to granular telemetry points—is private and 
 * accessible only by the authenticated user who owns that specific data tree.
 *
 * DATA STRUCTURE:
 * The data is organized into a nested hierarchy:
 * /users/{userId} -> The root document for a pilot/operator.
 *   /flightLogs/{flightLogId} -> Metadata for a specific drone flight.
 *     /telemetryPoints/{telemetryPointId} -> Time-series location and status data for that flight.
 *     /detectionEvents/{detectionEventId} -> AI-generated events (e.g., camel sightings) for that flight.
 *
 * KEY SECURITY DECISIONS:
 * 1. Path-Based Authorization: All authorization logic relies on comparing the {userId} 
 *    in the document path with the 'request.auth.uid'. This provides high-performance 
 *    security without the need for expensive 'get()' cross-document lookups.
 * 2. Relational Integrity: While in prototyping mode we don't enforce strict schema 
 *    validation for all fields, we DO enforce that 'flightLogId' fields within subcollections 
 *    match the ID in the path to prevent data corruption or unauthorized cross-linking.
 * 3. Implicit Write Safety: Destructive operations (update, delete) are strictly 
 *    guarded to ensure the document exists and the requester is the verified owner.
 * 4. Anonymous Support: Rules are designed to support 'anonymous' and 'password' 
 *    providers as defined in the application requirements, relying solely on the 
 *    assigned UID.
 */

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- GLOBAL HELPER FUNCTIONS ---

    /** Checks if the request is from an authenticated user. */
    function isSignedIn() {
      return request.auth != null;
    }

    /** Checks if the authenticated user's UID matches the provided userId. */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /** Checks if the user is the owner and the document exists for state-changing operations. */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    // --- COLLECTION RULES ---

    /**
     * @description Rules for the root user document. Enables self-creation and profile management.
     * @path /users/{userId}
     * @allow (create) if user 'abc' is authenticated and creating /users/abc.
     * @deny (create) if user 'abc' tries to create /users/xyz.
     * @principle P3.4: Self-Creation pattern for root user documents.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Users cannot list other users.
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);

      /**
       * @description Rules for flight logs. Metadata for a specific flight session.
       * @path /users/{userId}/flightLogs/{flightLogId}
       * @allow (get, list) if the authenticated user matches the userId in the path.
       * @deny (create) if 'id' in data does not match the 'flightLogId' in the path.
       * @principle P5: Validates path-to-data consistency for relational integrity.
       */
      match /flightLogs/{flightLogId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && request.resource.data.id == flightLogId;
        allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
        allow delete: if isExistingOwner(userId);

        /**
         * @description Rules for telemetry points. High-frequency data snapshots.
         * @path /users/{userId}/flightLogs/{flightLogId}/telemetryPoints/{telemetryPointId}
         * @allow (list) if the owner is viewing points for their own flight.
         * @deny (create) if 'flightLogId' in data doesn't match parent flightLogId.
         * @principle P3.1: Ownership pattern combined with subcollection path validation.
         */
        match /telemetryPoints/{telemetryPointId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.flightLogId == flightLogId;
          allow update: if isExistingOwner(userId) && request.resource.data.flightLogId == resource.data.flightLogId;
          allow delete: if isExistingOwner(userId);
        }

        /**
         * @description Rules for detection events. AI object detections recorded during flight.
         * @path /users/{userId}/flightLogs/{flightLogId}/detectionEvents/{detectionEventId}
         * @allow (create) if the user is the owner and links the event to the correct flight.
         * @deny (list) if an unauthenticated user or different user attempts to access.
         * @principle P7: Verification of document existence for updates and deletions.
         */
        match /detectionEvents/{detectionEventId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && request.resource.data.flightLogId == flightLogId;
          allow update: if isExistingOwner(userId) && request.resource.data.flightLogId == resource.data.flightLogId;
          allow delete: if isExistingOwner(userId);
        }
      }
    }
    
    // --- DEFAULT DENY ---
    match /{path=**} {
      allow read, write: if false;
    }
  }
}